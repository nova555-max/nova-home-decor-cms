# Production — set in Cloudflare Pages / Workers dashboard (never commit real values)

# ── Public (NEXT_PUBLIC_*) ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Or: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_APP_URL=https://your-domain.pages.dev
NEXT_PUBLIC_DEFAULT_LOCALE=ku
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ── Server-only (encrypted in Cloudflare) ───────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPER_ADMIN_EMAIL=admin@your-domain.com

# Password reset emails (Resend)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Nova Home Decor <noreply@your-domain.com>

# Google Gemini AI (server-only)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3-flash-preview

# ── Production safety ─────────────────────────────────────────────────────────
# Do NOT set these in production:
# DEV_AUTH_ENABLED=true
# DEV_ADMIN_EMAIL=...
# DEV_ADMIN_PASSWORD=...
