# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Legacy anon JWT key OR modern publishable key (either works)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=ku

# Google Maps — interactive location picker in admin (Maps JavaScript API + Geocoding API)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Super Admin (only one — bootstrap account)
SUPER_ADMIN_EMAIL=admin@novahomedecor.com

# Server-only — editors + password reset (Supabase → Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — password reset emails for admin
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Nova Home Decor <onboarding@resend.dev>

# Google Gemini — server-only AI (never expose to client)
GEMINI_API_KEY=your-gemini-api-key
# gemini-3.5-flash for new API keys; gemini-3-flash-preview as fallback
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3-flash-preview

# Temporary dev login (localhost only — MUST be false in production)
# Set DEV_AUTH_ENABLED=false before deploying. Rotate credentials if ever exposed.
DEV_AUTH_ENABLED=true
DEV_ADMIN_EMAIL=admin@novahomedecor.com
DEV_ADMIN_PASSWORD=change-me-before-production
