{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nova-home-decor-cms",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  // Keep dashboard Secrets across deploys (do not wipe remote encrypted secrets).
  "keep_vars": true,
  // Public runtime config — safe to commit. Secrets stay in the Cloudflare dashboard.
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://nblnwcacdlafvgrxfldv.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_q5BPT1JI_h9D3sZ855X3Iw_OI14rGW",
    "NEXT_PUBLIC_APP_URL": "https://nova-home-decor-cms.novahome756.workers.dev",
    "NEXT_PUBLIC_DEFAULT_LOCALE": "ku",
    "SUPER_ADMIN_EMAIL": "novahome756@gmail.com"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nova-home-decor-cms"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
  // Optional: enable Next.js incremental cache on R2 (create bucket in Cloudflare dashboard first)
  // "r2_buckets": [
  //   {
  //     "binding": "NEXT_INC_CACHE_R2_BUCKET",
  //     "bucket_name": "nova-home-decor-cache"
  //   }
  // ]
}
