{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nova-home-decor-cms",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  // Keep dashboard Variables & Secrets across deploys (do not wipe remote vars).
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nova-home-decor-cms"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
  // Optional: enable Next.js incremental cache on R2 (create bucket in Cloudflare dashboard first)
  // "r2_buckets": [
  //   {
  //     "binding": "NEXT_INC_CACHE_R2_BUCKET",
  //     "bucket_name": "nova-home-decor-cache"
  //   }
  // ]
}
