{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nova-home-decor-cms",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  // Keep dashboard Secrets across deploys (do not wipe remote encrypted secrets).
  "keep_vars": true,
  // Public non-secret runtime config only. Secrets (SERVICE_ROLE, RESEND, GEMINI)
  // must be set in Cloudflare Dashboard → Variables and Secrets — never commit them.
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://nblnwcacdlafvgrxfldv.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_q5BPT1JI_h9D3sZ855X3Iw_OI14rGW",
    "NEXT_PUBLIC_APP_URL": "https://nova-home-decor-cms.novahome756.workers.dev",
    "NEXT_PUBLIC_DEFAULT_LOCALE": "ku",
    "SUPER_ADMIN_EMAIL": "novahome756@gmail.com",
    "RESEND_FROM_EMAIL": "Nova Home Decor <onboarding@resend.dev>"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nova-home-decor-cms"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
